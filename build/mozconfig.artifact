# Nash — itération sur l'interface.
# Aucune compilation C++ : Mozilla fournit les binaires, on ne construit que la
# couche chrome (JS/CSS).
#
#   MOZCONFIG=~/Nash/build/mozconfig.artifact ./mach build
#   MOZCONFIG=~/Nash/build/mozconfig.artifact ./mach run

ac_add_options --enable-artifact-builds
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../nash-obj-artifact

# Volontairement absent : --disable-crashreporter et --disable-updater
# modifient du code compilé, sans effet en mode artifact où les binaires
# arrivent déjà construits. Ils appartiennent à mozconfig.full.
#
# Marque Nash. Obligatoire : une compilation non officielle n'a pas le droit
# de s'appeler Firefox ni d'en porter les icônes.
ac_add_options --with-branding=browser/branding/nash

# Identité du paquet seulement : le lanceur artifact reste celui de Firefox.
# Utiliser tools/run-dev.sh et son profil explicite. L’identité runtime exige
# mozconfig.full (voir D9).
export MOZ_APP_BASENAME=Nash
export MOZ_APP_REMOTINGNAME=nash
export MOZ_APP_NAME=firefox   # conservé : l'artifact amont fournit un binaire nommé « firefox »

# Le bundle id se compose ainsi : <distribution-id>.<MOZ_MACBUNDLE_ID>.
# Par défaut cela donnerait org.mozilla.nash, ce qui revendique à tort le
# namespace de Mozilla.
ac_add_options --with-distribution-id=org.nash
